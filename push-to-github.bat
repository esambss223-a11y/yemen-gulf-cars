@echo off
chcp 65001 >nul
title Yemen Gulf Cars - رفع التعديلات إلى GitHub
cd /d "%~dp0"

echo ======================================================
echo      🚀 أداة رفع التحديثات إلى GitHub بضغطة زر
echo ======================================================
echo.

:: 1. عرض حالة الملفات
echo [1/3] فحص الملفات والتعديلات...
git status -s

echo.
set /p commit_msg="اكتب وصف التعديلات (أو اضغط Enter للاعتماد التلقائي): "

if "%commit_msg%"=="" (
    set commit_msg=تحديث تلقائي: %date% %time%
)

echo.
echo [2/3] تجهيز وحفظ التعديلات محلياً...
git add .
git commit -m "%commit_msg%"

echo.
echo [3/3] جاري الرفع إلى مستودع GitHub...
git push origin main

if %ERRORLEVEL% equ 0 (
    echo.
    echo ======================================================
    echo   ✅ تم رفع التعديلات إلى GitHub بنجاح تام!
    echo ======================================================
) else (
    echo.
    echo ======================================================
    echo   ⚠️ حدثت مشكلة أثناء الرفع، راجع التفاصيل في الأعلى.
    echo ======================================================
)

echo.
echo اضغط أي مفتاح لإغلاق هذه النافذة...
pause >nul
