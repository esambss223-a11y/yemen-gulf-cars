@echo off
chcp 65001 >nul
title تطبيق شركة اليمن والخليج - بناء ملف التثبيت v1.1.0
cd /d "%~dp0desktop-app"

echo ======================================================
echo    📦 بناء ملف التثبيت الرسمي لويندوز (.exe)
echo    تطبيق شركة اليمن والخليج لتأجير السيارات - الإصدار 1.1.0
echo ======================================================
echo.

if not exist "node_modules" (
    echo [1/2] فحص وتثبيت الحزم المطلوبة...
    call npm install
    echo.
)

echo [2/2] جاري تجميع التطبيق وإنشاء ملف التثبيت الرسمي...
echo يرجى الانتظار لحظات...
echo.

call npm run dist

if %ERRORLEVEL% equ 0 (
    echo.
    echo ======================================================
    echo   ✅ تم بناء تطبيق شركة اليمن والخليج بنجاح تام!
    echo ======================================================
    copy /y "dist\تطبيق شركة اليمن والخليج Setup 1.1.0.exe" "..\" >nul
    explorer /select,"..\\تطبيق شركة اليمن والخليج Setup 1.1.0.exe"
) else (
    echo.
    echo ======================================================
    echo   ⚠️ حدث خطأ أثناء التجميع، راجع التفاصيل في الأعلى.
    echo ======================================================
)

echo.
echo اضغط أي مفتاح لإغلاق هذه النافذة...
pause >nul
