{
  "name": "yemen-gulf-cars-app",
  "productName": "تطبيق شركة اليمن والخليج",
  "version": "1.1.0",
  "description": "تطبيق شركة اليمن والخليج لتأجير السيارات - نظام إدارة الأسطول والحجوزات",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [
    "yemen",
    "gulf",
    "cars",
    "admin",
    "desktop"
  ],
  "author": "شركة اليمن والخليج لتأجير السيارات",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ygcarss.app",
    "productName": "تطبيق شركة اليمن والخليج",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "artifactName": "تطبيق شركة اليمن والخليج Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "تطبيق شركة اليمن والخليج",
      "installerLanguages": [
        "ar",
        "en"
      ]
    }
  }
}
