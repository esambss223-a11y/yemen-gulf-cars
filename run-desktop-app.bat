@echo off
chcp 65001 >nul
title تطبيق شركة اليمن والخليج - تشغيل التطبيق v1.1.0
cd /d "%~dp0desktop-app"

echo ======================================================
echo    🚗 تطبيق شركة اليمن والخليج لتأجير السيارات
echo    لوحة تحكم الأسطول والعقود - الإصدار 1.1.0
echo ======================================================
echo.

if not exist "node_modules" (
    echo [1/2] تجهيز الحزم للمرة الأولى...
    call npm install
    echo.
)

echo [2/2] جاري تشغيل التطبيق المكتبي بهوية الشركة الرسمية...
echo ------------------------------------------------------
echo  💡 الشعار الرسمي المعتمد: logoexe.png
echo  💡 التحديثات حية ومباشرة من السيرفر السحابي
echo  💡 الطباعة تدعم طابعات ويندوز وحفظ PDF بدقة A4
echo ------------------------------------------------------
echo.

call npm start

if %ERRORLEVEL% neq 0 (
    echo.
    echo ⚠️ حدث خطأ أثناء تشغيل التطبيق!
    pause
)
